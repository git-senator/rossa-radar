# --- обязательное -----------------------------------------------------------
# YouTube Data API v3 (Google Cloud → APIs & Services → Credentials).
# Только чтение публичных комментариев. В браузер не попадает.
YOUTUBE_API_KEY=

# Модель, которая оценивает комментарии. Без неё радар не работает: решение,
# кто здесь потенциальный клиент, принимает она, а не правила в коде.
# Подходит любой сервис с OpenAI-совместимым API — эти же ключи используются
# и для перевода, отдельные JUDGE_* нужны только чтобы развести оценку и
# перевод по разным моделям.
TRANSLATE_API_KEY=

# Gemini — предпочтительно. Бесплатный тариф даёт на порядки больший лимит
# токенов в минуту, а ключ берётся из того же Google Cloud проекта, что и
# ключ YouTube:
#   TRANSLATE_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
#   TRANSLATE_MODEL=gemini-flash-latest
#
# Groq — быстрее, но бесплатный тариф ограничен 8 000 токенами в минуту.
# Этого хватает примерно на один обход в час и ни на что сверх того:
#   TRANSLATE_API_BASE=https://api.groq.com/openai/v1
#   TRANSLATE_MODEL=openai/gpt-oss-120b
TRANSLATE_API_BASE=
TRANSLATE_MODEL=

# --- оценка отдельной моделью (необязательное) -------------------------------
# Если заданы — используются для оценки вместо TRANSLATE_*. Удобно, когда
# переводить хочется дешёвой моделью, а оценивать умной.
# JUDGE_API_KEY=
# JUDGE_API_BASE=
# JUDGE_MODEL=
