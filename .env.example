# --- обязательное -----------------------------------------------------------
# YouTube Data API v3 (Google Cloud → APIs & Services → Credentials).
# Только чтение публичных комментариев. В браузер не попадает.
YOUTUBE_API_KEY=

# --- перевод комментариев на русский (необязательное) -----------------------
# Любой сервис с OpenAI-совместимым API. Без ключа приложение работает,
# просто под комментариями не будет перевода.
TRANSLATE_API_KEY=

# Gemini (бесплатный тариф, ключ из того же Google Cloud проекта):
#   TRANSLATE_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
#   TRANSLATE_MODEL=gemini-flash-latest
#
# Groq (быстрее, отдельный аккаунт):
#   TRANSLATE_API_BASE=https://api.groq.com/openai/v1
#   TRANSLATE_MODEL=llama-3.3-70b-versatile
TRANSLATE_API_BASE=
TRANSLATE_MODEL=
